dnl Autotools config.m4 for PHP extension flexid

PHP_ARG_ENABLE([flexid_utils],
  [whether to enable flexid support],
  [AS_HELP_STRING([--enable-flexid_utils],
    [Enable flexid support])],
  [no])

AS_VAR_IF([PHP_FLEXID_UTILS], [no],, [
  dnl This section is executed when extension is enabled with one of the above
  dnl configure options. Adjust and add tests here.

  AC_DEFINE([HAVE_FLEXID_UTILS], [1],
    [Define to 1 if the PHP extension 'flexid' is available.])

  dnl Configure extension sources and compilation flags.
  PHP_NEW_EXTENSION([flexid_utils],
    [flexid_utils.c siphash.c blake3.c sparx64.c sparx128.c encoder.c hash_encoder.c],
    [$ext_shared],,
    [-DZEND_ENABLE_STATIC_TSRMLS_CACHE=1])
    AC_DEFINE_UNQUOTED([PHP_FLEXID_UTILS_VERSION], ["$PHP_FLEXID_UTILS_VERSION"], [Extension version])

  AC_ARG_WITH([version],
    [AS_HELP_STRING([--with-version=VERSION], [Extension version string])],
    [PHP_FLEXID_UTILS_VERSION="$withval"],
    [PHP_FLEXID_UTILS_VERSION="dev"])

  dnl Sanity-check: reject empty or obviously bad values.
  AS_IF([test "x$PHP_FLEXID_UTILS_VERSION" = "x"], [
    AC_MSG_ERROR([--with-version must not be empty])
  ])

  AC_DEFINE_UNQUOTED([PHP_FLEXID_UTILS_VERSION], ["$PHP_FLEXID_UTILS_VERSION"],
    [extension version])

  dnl Make it available to files generated by config.status if needed.
  AC_SUBST([MYEXT_VERSION])
])
